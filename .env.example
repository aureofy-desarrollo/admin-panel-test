# Configuración del Backend PaaS
# IMPORTANTE: Este archivo NO debe ser commiteado al repositorio
# Agregar .env a .gitignore

# ============================================================================
# CONFIGURACIÓN DEL API
# ============================================================================

# URL base del API del PaaS (sin trailing slash)
# Producción:
PAAS_API_URL=https://api.paas.production.com

# Staging (para pruebas):
# PAAS_API_URL=https://api.paas.staging.com

# Desarrollo local (si aplica):
# PAAS_API_URL=http://localhost:8000


# ============================================================================
# CREDENCIALES DE AUTENTICACIÓN
# ============================================================================

# API Key proporcionada por el equipo de backend
PAAS_API_KEY=your_api_key_here

# API Secret proporcionada por el equipo de backend
PAAS_API_SECRET=your_api_secret_here


# ============================================================================
# CONFIGURACIÓN OPCIONAL
# ============================================================================

# Timeout para peticiones HTTP (en segundos)
PAAS_REQUEST_TIMEOUT=30

# Número máximo de reintentos en caso de fallo
PAAS_MAX_RETRIES=3

# Delay entre reintentos (en segundos)
PAAS_RETRY_DELAY=1

# Habilitar logging detallado (true/false)
PAAS_DEBUG_MODE=false

# Tamaño de página para listados
PAAS_PAGE_SIZE=50


# ============================================================================
# NOTAS DE CONFIGURACIÓN
# ============================================================================

# 1. Obtener credenciales:
#    Contactar al equipo de backend para obtener API_KEY y API_SECRET
#
# 2. Configurar en Odoo:
#    Ir a: PaaS Management > Configuration
#    Ingresar los valores de API_URL, API_KEY y API_SECRET
#
# 3. Probar conexión:
#    Hacer clic en el botón "Test Connection" en la configuración
#
# 4. Sincronización inicial:
#    Ir a: PaaS Management > Sync
#    Ejecutar sincronización completa
#
# 5. Monitoreo:
#    Revisar logs de Odoo para verificar que las peticiones HTTP
#    se están realizando correctamente
