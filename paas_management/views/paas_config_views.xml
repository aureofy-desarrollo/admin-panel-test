<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_paas_config_tree" model="ir.ui.view">
        <field name="name">paas.config.list</field>
        <field name="model">paas.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="base_url"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_paas_config_form" model="ir.ui.view">
        <field name="name">paas.config.form</field>
        <field name="model">paas.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" string="Test Connection" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="base_url"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="admin_token" password="True"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_paas_config" model="ir.actions.act_window">
        <field name="name">API Configuration</field>
        <field name="res_model">paas.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_paas_config"
              name="Configuration"
              parent="menu_paas_root"
              action="action_paas_config"
              sequence="100"
              groups="base.group_system"/>
</odoo>
