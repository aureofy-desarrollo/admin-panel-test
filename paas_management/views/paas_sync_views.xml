<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_paas_sync_wizard_form" model="ir.ui.view">
        <field name="name">paas.sync.wizard.form</field>
        <field name="model">paas.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Synchronize with Backend">
                <group>
                    <field name="sync_plans"/>
                    <field name="sync_users"/>
                </group>
                <footer>
                    <button name="action_sync" string="Start Synchronization" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_paas_sync_wizard" model="ir.actions.act_window">
        <field name="name">Sync with Backend</field>
        <field name="res_model">paas.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_paas_sync"
              name="Sync with Backend"
              parent="menu_paas_root"
              action="action_paas_sync_wizard"
              sequence="50"/>
</odoo>
